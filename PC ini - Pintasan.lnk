<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Materi Digital Proyek Kemanusiaan 2026</title>
  <meta name="description" content="Eksplorasi modul edukasi Proyek Kemanusiaan Berdampak -Sosiologi 2026.">

  <link rel="preconnect" href="https://googleapis.com">
  <link rel="preconnect" href="https://gstatic.com" crossorigin>
  <link href="https://googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">

  <style>
    * { box-sizing: border-box; }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #fff7ed;
      background-image: radial-gradient(#fdba74 1.5px, transparent 1.5px);
      background-size: 24px 24px;
      margin: 0; padding: 0; color: #18181b;
      display: flex; flex-direction: column; min-height: 100vh;
    }
    .wrapper-atas { max-width: 1080px; width: 100%; margin: 30px auto 20px auto; padding: 0 20px; }
    .bento-hero {
      background-color: #f97316; border: 3px solid #18181b; border-radius: 24px;
      padding: 36px 32px; box-shadow: 8px 8px 0px #18181b;
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
      gap: 24px; color: #ffffff;
    }
    .hero-kiri { flex: 1; min-width: 280px; }
    .tag-pill {
      display: inline-block; background-color: #fef08a; color: #18181b;
      font-weight: 800; font-size: 12px; padding: 6px 14px;
      border: 2px solid #18181b; border-radius: 99px; margin-bottom: 14px;
      text-transform: uppercase; letter-spacing: 0.5px; box-shadow: 3px 3px 0px #18181b;
    }
    .bento-hero h1 {
      font-family: 'Space Grotesk', sans-serif; font-size: 34px; line-height: 1.15;
      margin: 0 0 12px 0; color: #ffffff; text-shadow: 2px 2px 0px #18181b;
    }
    .bento-hero p { font-size: 15px; line-height: 1.6; margin: 0; color: #fff7ed; max-width: 580px; }
    .hero-logo-box {
      background-color: #ffffff; border: 3px solid #18181b; border-radius: 20px;
      padding: 18px; box-shadow: 6px 6px 0px #18181b;
      display: flex; align-items: center; justify-content: center;
    }
    .hero-logo-box img { max-height: 85px; width: auto; display: block; }
    .search-section { max-width: 1080px; width: 100%; margin: 15px auto 30px auto; padding: 0 20px; }
    .kotak-cari {
      width: 100%; padding: 16px 24px; font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 16px; font-weight: 700; background-color: #ffffff; color: #18181b;
      border: 3px solid #18181b; border-radius: 16px; box-shadow: 6px 6px 0px #f97316;
      outline: none; transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .kotak-cari:focus { transform: translate(-2px, -2px); box-shadow: 8px 8px 0px #18181b; }
    .grid-bento {
      max-width: 1080px; width: 100%; margin: 0 auto; padding: 0 20px;
      display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 26px; flex-grow: 1;
    }
    .kartu-genz {
      background-color: #ffffff; border: 3px solid #18181b; border-radius: 20px;
      overflow: hidden; text-decoration: none; color: inherit; box-shadow: 6px 6px 0px #18181b;
      transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
      display: flex; flex-direction: column; position: relative;
    }
    .kartu-genz:hover { transform: translate(-4px, -4px); box-shadow: 10px 10px 0px #f97316; background-color: #fffaf5; }
    .wadah-gambar { position: relative; border-bottom: 3px solid #18181b; height: 185px; overflow: hidden; }
    .wadah-gambar img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .badge-nomor {
      position: absolute; top: 12px; left: 12px; background-color: #f97316; color: #ffffff;
      font-family: 'Space Grotesk', sans-serif; font-size: 13px; font-weight: 700;
      padding: 5px 12px; border: 2px solid #18181b; border-radius: 10px; box-shadow: 3px 3px 0px #18181b;
    }
    .konten-kartu { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; }
    .judul-materi { font-size: 18px; font-weight: 800; line-height: 1.35; margin: 0 0 10px 0; color: #18181b; }
    .deskripsi-singkat { font-size: 14px; color: #52525b; line-height: 1.5; margin: 0 0 18px 0; }
    .tombol-aksi {
      margin-top: auto; display: inline-flex; align-items: center; justify-content: space-between;
      background-color: #ffedd5; color: #c2410c; font-weight: 800; font-size: 13px;
      padding: 10px 14px; border: 2px solid #18181b; border-radius: 12px;
      transition: background-color 0.15s ease, color 0.15s ease;
    }
    .kartu-genz:hover .tombol-aksi { background-color: #f97316; color: #ffffff; }
    .footer-wrapper { max-width: 1080px; width: 100%; margin: 50px auto 30px auto; padding: 0 20px; }
    .footer-box {
      background-color: #18181b; color: #f4f4f5; border: 3px solid #18181b;
      border-radius: 22px; padding: 28px 32px; box-shadow: 8px 8px 0px #f97316;
      display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px;
    }
    .info-kredit div { margin-bottom: 6px; font-size: 14px; }
    .info-kredit span { color: #fb923c; font-weight: 800; }
    .copyright-badge {
      background-color: #27272a; border: 2px solid #f97316; color: #fed7aa;
      padding: 8px 16px; border-radius: 12px; font-size: 12px; font-weight: 700;
    }
  </style>
</head>
<body>

  <div class="wrapper-atas">
    <header class="bento-hero">
